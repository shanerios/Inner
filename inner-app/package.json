{
  "name": "inner-app",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:tunnel": "npx expo start --tunnel -c",
    "typecheck": "tsc --noEmit",
    "voice:measure": "node scripts/measure-voice-clips.js",
    "voice:normalize": "node scripts/normalize-voice-clips.js",
    "voice:manifest": "node scripts/voice-manifest.js",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/hooks": "^100.1.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "4.5.6",
    "@react-navigation/native": "^7.1.16",
    "@react-navigation/native-stack": "^7.3.23",
    "@react-navigation/stack": "^7.4.4",
    "@sentry/react-native": "8.15.1",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^2.1.5",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "getenv": "^2.0.0",
    "jest-expo": "~54.0.18",
    "lodash": "^4.17.21",
    "lottie-react-native": "~7.3.1",
    "posthog-react-native": "^4.37.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chottulink-sdk": "^1.1.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^9.10.0",
    "react-native-reanimated": "~3.19.5",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-spotlight-tour": "^4.0.0",
    "react-native-svg": "15.12.1",
    "react-native-track-player": "^4.1.2",
    "react-native-webview": "13.15.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-flow": "^7.27.1",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "expo-dev-client": "~6.0.21",
    "node-addon-api": "^8.8.0",
    "node-gyp": "^12.4.0",
    "patch-package": "^8.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@noble/ciphers/.*))"
    ]
  },
  "volta": {
    "node": "20.20.0",
    "npm": "10.9.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react-native-reanimated",
        "@react-native-community/slider"
      ]
    }
  }
}
