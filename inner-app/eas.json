{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProdDebug"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_INNER_CHANNEL": "dev"
      },
      "environment": "development"
    },
    "development-client": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "apk": {
      "channel": "preview",
      "environment": "production",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProdRelease"
      },
      "env": {
        "EXPO_PUBLIC_INNER_CHANNEL": "internal"
      }
    },
    "lab": {
      "distribution": "internal",
      "channel": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProceduralDevRelease"
      },
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0",
        "EXPO_PUBLIC_INNER_LAB": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_INNER_CHANNEL": "lab"
      }
    },
    "internal": {
      "channel": "internal",
      "environment": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleProdRelease"
      },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0",
        "EXPO_PUBLIC_INNER_CHANNEL": "internal"
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "environment": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleProdRelease"
      },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0",
        "EXPO_PUBLIC_INNER_CHANNEL": "beta"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleProdRelease"
      },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0",
        "EXPO_PUBLIC_INNER_CHANNEL": "production"
      }
    }
  },
  "submit": {
    "internal": {
      "ios": {
        "ascAppId": "6755213270"
      },
      "android": {
        "track": "internal",
        "changesNotSentForReview": true
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6755213270"
      },
      "android": {
        "track": "closed",
        "changesNotSentForReview": true
      }
    },
    "open": {
      "android": {
        "track": "open",
        "changesNotSentForReview": true
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6755213270"
      },
      "android": {
        "track": "production",
        "changesNotSentForReview": false
      }
    },
    "internal-track": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
