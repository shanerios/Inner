{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleProdDebug" },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0"
      }
    },
    "development-client": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "apk": {
      "channel": "preview",
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleProdRelease" }
    },
    "lab": {
      "distribution": "internal",
      "channel": "internal",
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleProceduralDevRelease" },
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0",
        "EXPO_PUBLIC_INNER_LAB": "1"
      }
    },
    "internal": {
      "channel": "internal",
      "android": { "buildType": "app-bundle", "gradleCommand": ":app:bundleProdRelease" },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0"
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "android": { "buildType": "app-bundle", "gradleCommand": ":app:bundleProdRelease" },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "android": { "buildType": "app-bundle", "gradleCommand": ":app:bundleProdRelease" },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_NEW_ARCH_ENABLED": "0"
      }
    }
  },
  "submit": {
    "internal": {
      "ios": {
        "ascAppId": "6755213270"
      },
      "android": {
        "track": "internal",
        "changesNotSentForReview": true
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6755213270"
      },
      "android": {
        "track": "closed",
        "changesNotSentForReview": true
      }
    },
    "open": {
      "android": {
        "track": "open",
        "changesNotSentForReview": true
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6755213270"
      },
      "android": {
        "track": "production",
        "changesNotSentForReview": false
      }
    }
  }
}
